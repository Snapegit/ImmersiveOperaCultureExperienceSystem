<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.XiquzhishiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.XiquzhishiEntity" id="xiquzhishiMap">
        <result property="biaoti" column="biaoti"/>
        <result property="fengmian" column="fengmian"/>
        <result property="neirong" column="neirong"/>
        <result property="fabushijian" column="fabushijian"/>
        <result property="thumbsupnum" column="thumbsupnum"/>
        <result property="crazilynum" column="crazilynum"/>
        <result property="storeupnum" column="storeupnum"/>
        <result property="clicktime" column="clicktime"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.XiquzhishiView" >

		SELECT  xiquzhishi.* FROM xiquzhishi  xiquzhishi 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.XiquzhishiView" >
		SELECT * FROM xiquzhishi  xiquzhishi <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
